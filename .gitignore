# Real production secrets — NEVER commit.
.env
.env.local
.env.production
.env.bak.*

# Rendered from Caddyfile.template by install.sh. Generated, not authored —
# committing it is exactly what turned the domain substitution into a silent
# no-op, since the sed pattern no longer matched the baked-in hostname.
Caddyfile
Caddyfile.bak.*
Caddyfile.rollback
.Caddyfile.tmp.*
.env.tmp.*
.env.db.tmp.*
.test-install.*
.test-release.*
.validation-caddy/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode
.idea
*.swp

# Terraform state and saved plans can contain sensitive provider metadata.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
*.tfbackend
!*.tfbackend.example
crash.log
**/password_override.tf
