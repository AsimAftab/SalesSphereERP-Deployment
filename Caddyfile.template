# Rendered atomically by install.sh and deploy.sh.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{{API_DOMAIN}} {
	tls {
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	import security_headers
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"

	# Caddy forwards WebSocket upgrade requests automatically, including the
	# backend Socket.io endpoint.
	reverse_proxy app:3000

	log {
		output stdout
		format json
	}
}

{{FRONTEND_DOMAIN}} {
	tls {
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	import security_headers
	# The SPA reads the user's position (location picker, web attendance), so
	# geolocation must be allowed for its own origin. The API never needs it.
	header Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
	reverse_proxy frontend:8080

	log {
		output stdout
		format json
	}
}
