# SalesSphere ERP production configuration.
# Copy to .env on the server, fill secrets, then chmod 600 .env.

# --- Images ---
# Backend service name `app` and IMAGE_TAG are retained for existing CI.
IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
GHCR_IMAGE=ghcr.io/asimaftab/salessphere-erp-backend
FRONTEND_GHCR_IMAGE=ghcr.io/asimaftab/salessphere-erp-frontend

# --- Public hosts ---
API_DOMAIN=api.salessphere360.tech
FRONTEND_DOMAIN=salessphere360.tech
AUTH_SITE_DOMAIN=salessphere360.tech

# --- Server ---
NODE_ENV=production
PORT=3000
APP_URL=https://api.salessphere360.tech
CORS_ORIGIN=https://salessphere360.tech
MARKETING_URL=https://salessphere360.tech

# --- Database ---
# Use the provider's production Postgres connection string.
DATABASE_URL=postgresql://user:password@database.example.com:5432/salessphere?sslmode=require

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=<generate-a-fresh-32+-char-random-string>
JWT_REFRESH_SECRET=<a-different-32+-char-random-string>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CSRF_SECRET=<another-different-32+-char-random-string>
COOKIE_DOMAIN=api.salessphere360.tech

# --- File storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=salessphere-prod

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=no-reply@salessphere.com
SMTP_FROM_NAME=SalesSphere
PASSWORD_RESET_URL=https://salessphere360.tech/auth/reset-password
EMAIL_VERIFICATION_URL=https://salessphere360.tech/auth/verify-email
RESEND_API_KEY=

# --- Platform super-admin ---
SUPERADMIN_EMAIL=admin@salessphere.com
SUPERADMIN_PASSWORD=<generate-a-strong-password-and-rotate-immediately>

# --- IRD (Nepal Inland Revenue) ---
IRD_ENABLED=false
IRD_API_BASE=
IRD_TAXPAYER_PAN=
IRD_SOFTWARE_ID=

# --- Logging ---
LOG_LEVEL=info
